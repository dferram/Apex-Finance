# Database - Azure PostgreSQL
# Reemplaza [USERNAME], [PASSWORD] con tus credenciales de Azure
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@apexfinancedb.postgres.database.azure.com:5432/postgres?sslmode=require

# Google AI (Gemini)
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Node Environment
NODE_ENV=development
